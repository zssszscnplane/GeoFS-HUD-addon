// @name         GeoFS Flight HUD addon
// @namespace    https://www.geo-fs.com/geofs.php?v=3.9
// @version      5.7.0
// @description  A350-style HUD | posture meter interval adjustable | Open source and free. Reselling is prohibited. | Press "L" to open or close.
// @author       zssszscnplane
// @match        https://www.geo-fs.com/geofs.php?v=3.9
// @grant        none
// @run-at       document-end
